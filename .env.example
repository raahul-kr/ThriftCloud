APP_NAME=ThriftCloud
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+psycopg://thriftcloud:thriftcloud@postgres:5432/thriftcloud
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=thriftcloud
POSTGRES_USER=thriftcloud
POSTGRES_PASSWORD=thriftcloud

